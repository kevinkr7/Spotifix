# Spotifix Environment Variables Template
# Copy this file to .env and provide your actual values.
# NEVER commit .env to version control!

# Database Configuration
# Format for Neon: jdbc:postgresql://<host>:5432/<dbname>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/spotifix
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Application Configuration
SERVER_PORT=8081
SHOW_SQL=false

# Media Storage Directory
SPOTIFIX_UPLOAD_DIR=uploads

# Cookie Security (set to true in production over HTTPS)
SESSION_COOKIE_SECURE=false

# Jamendo Music API Configuration (Get your free Client ID at https://devportal.jamendo.com)
JAMENDO_CLIENT_ID=your_jamendo_client_id_here
JAMENDO_BASE_URL=https://api.jamendo.com/v3.0

# YouTube Data API v3 Configuration (Get your API key at https://console.cloud.google.com)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3

